<!DOCTYPE html>
<html lang="pt">
<head>
<%- include('partials/head') %>
</head>
<body class="page-home">
<%- include('partials/nav') %>

<section class="hero-simple">
  <div class="hero-simple-inner">
    <div class="hero-logo-wrap">
      <svg class="hero-logo" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
        <circle cx="32" cy="32" r="27" fill="none" stroke="#c9a16a" stroke-width="1.6"/>
        <circle cx="32" cy="32" r="22" fill="none" stroke="#c9a16a" stroke-width="0.6" opacity="0.5"/>
        <path d="M32 2v8M32 54v8M2 32h8M54 32h8" stroke="#c9a16a" stroke-width="1.6" stroke-linecap="round"/>
        <text x="32" y="40" font-family="'Unbounded', sans-serif" font-size="19" font-weight="600" fill="#c9a16a" text-anchor="middle">SR</text>
      </svg>
      <p class="hero-logo-word">SR Transferes</p>
      <p class="hero-logo-tagline">Chauffeur Excellence</p>
    </div>
    <p class="hero-eyebrow"><%= t('hero.eyebrow') %></p>
    <h1><%= t('hero.title1') %> <%= t('hero.title2') %></h1>
    <p class="hero-lede"><%= t('hero.lede') %></p>
    <div class="hero-actions">
      <a href="/contacto" class="btn btn-primary" data-nav><%= t('hero.cta.reservar') %></a>
      <a href="/servicos" class="btn btn-ghost" data-nav><%= t('hero.cta.servicos') %></a>
    </div>
    <div class="hero-stats">
      <div><strong>24/7</strong><span><%= t('hero.stat.disponibilidade') %></span></div>
      <div><strong>+8 anos</strong><span><%= t('hero.stat.experiencia') %></span></div>
      <div><strong>100%</strong><span><%= t('hero.stat.pontualidade') %></span></div>
    </div>
  </div>
</section>

<section class="services-strip">
  <div class="strip-inner">
    <article class="strip-card">
      <h3><%= t('strip.aeroporto.title') %></h3>
      <p><%= t('strip.aeroporto.desc') %></p>
    </article>
    <article class="strip-card">
      <h3><%= t('strip.executivo.title') %></h3>
      <p><%= t('strip.executivo.desc') %></p>
    </article>
    <article class="strip-card">
      <h3><%= t('strip.eventos.title') %></h3>
      <p><%= t('strip.eventos.desc') %></p>
    </article>
  </div>
</section>

<section class="cta-band">
  <div class="cta-inner">
    <h2><%= t('cta.home.title') %></h2>
    <a href="/contacto" class="btn btn-primary" data-nav><%= t('cta.home.btn') %></a>
  </div>
</section>

<%- include('partials/footer') %>
</body>
</html>
