<!DOCTYPE html>
<html lang="pt">
<head>
<%- include('partials/head') %>
</head>
<body class="page-home">
<%- include('partials/nav') %>

<section class="hero">
  <div class="hero-scene" aria-hidden="true">
    <svg class="scene-sky" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMax slice">
      <defs>
        <linearGradient id="skyGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#040611"/>
          <stop offset="55%" stop-color="#060a17"/>
          <stop offset="100%" stop-color="#0b1424"/>
        </linearGradient>
        <linearGradient id="roadGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#0d1420"/>
          <stop offset="100%" stop-color="#161f30"/>
        </linearGradient>
        <radialGradient id="moonGlow" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#cfe0ff" stop-opacity="0.5"/>
          <stop offset="100%" stop-color="#cfe0ff" stop-opacity="0"/>
        </radialGradient>
      </defs>
      <rect width="1600" height="900" fill="url(#skyGrad)"/>
      <circle cx="1400" cy="110" r="70" fill="url(#moonGlow)"/>
      <circle cx="1400" cy="110" r="30" fill="#e7edf8"/>
      <circle cx="1391" cy="103" r="4" fill="#c7d2e0" opacity="0.5"/>
      <circle cx="1408" cy="116" r="3" fill="#c7d2e0" opacity="0.4"/>
      <g class="stars">
        <circle cx="120" cy="90" r="1.6" fill="#c7d2e0" opacity="0.6"/>
        <circle cx="260" cy="160" r="1.2" fill="#c7d2e0" opacity="0.5"/>
        <circle cx="420" cy="80" r="1.6" fill="#c7d2e0" opacity="0.7"/>
        <circle cx="700" cy="130" r="1.2" fill="#c7d2e0" opacity="0.4"/>
        <circle cx="980" cy="70" r="1.6" fill="#c7d2e0" opacity="0.6"/>
        <circle cx="1150" cy="200" r="1.2" fill="#c7d2e0" opacity="0.5"/>
      </g>
      <g class="skyline" fill="#0a1120">
        <rect x="60" y="520" width="60" height="240"/>
        <rect x="140" y="470" width="46" height="290"/>
        <rect x="200" y="560" width="80" height="200"/>
        <rect x="1180" y="500" width="70" height="260"/>
        <rect x="1270" y="440" width="50" height="320"/>
        <rect x="1340" y="540" width="90" height="220"/>
        <rect x="1440" y="490" width="55" height="270"/>
      </g>
      <g class="skyline-lights" fill="#3d7dfb" opacity="0.55">
        <rect x="72" y="540" width="6" height="6"/>
        <rect x="90" y="560" width="6" height="6"/>
        <rect x="160" y="500" width="6" height="6"/>
        <rect x="1200" y="530" width="6" height="6"/>
        <rect x="1290" y="470" width="6" height="6"/>
        <rect x="1360" y="570" width="6" height="6"/>
      </g>
    </svg>

    <svg class="scene-road" viewBox="0 0 1600 500" preserveAspectRatio="xMidYMax slice">
      <polygon points="600,0 1000,0 1560,500 40,500" fill="url(#roadGrad)"/>
      <polygon points="600,0 1000,0 1560,500 40,500" fill="none"/>
      <g class="lane-dashes">
        <polygon points="790,0 810,0 900,500 700,500" fill="#1c2740"/>
      </g>
      <g class="posts">
        <g class="post" style="--i:0"><rect x="120" y="260" width="6" height="90" fill="#1a2438"/><circle cx="123" cy="256" r="7" fill="#ffe9b0" opacity="0.85"/></g>
        <g class="post" style="--i:1"><rect x="1470" y="260" width="6" height="90" fill="#1a2438"/><circle cx="1473" cy="256" r="7" fill="#ffe9b0" opacity="0.85"/></g>
        <g class="post" style="--i:2"><rect x="260" y="330" width="7" height="120" fill="#1a2438"/><circle cx="263" cy="325" r="8" fill="#ffe9b0" opacity="0.85"/></g>
        <g class="post" style="--i:3"><rect x="1330" y="330" width="7" height="120" fill="#1a2438"/><circle cx="1333" cy="325" r="8" fill="#ffe9b0" opacity="0.85"/></g>
      </g>
    </svg>

    <svg class="scene-car" id="hero-car" viewBox="0 0 340 120" width="340" height="120">
      <defs>
        <linearGradient id="beamGrad2" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="#ffe9b0" stop-opacity="0.55"/>
          <stop offset="100%" stop-color="#ffe9b0" stop-opacity="0"/>
        </linearGradient>
        <linearGradient id="bodyGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#22314f"/>
          <stop offset="45%" stop-color="#101a2b"/>
          <stop offset="100%" stop-color="#080e18"/>
        </linearGradient>
        <linearGradient id="glassGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#9fb4dd" stop-opacity="0.45"/>
          <stop offset="100%" stop-color="#3d7dfb" stop-opacity="0.1"/>
        </linearGradient>
        <radialGradient id="wheelGrad" cx="35%" cy="35%" r="65%">
          <stop offset="0%" stop-color="#2a3a58"/>
          <stop offset="100%" stop-color="#050810"/>
        </radialGradient>
      </defs>

      <ellipse class="car-shadow" cx="172" cy="101" rx="130" ry="7" fill="rgba(0,0,0,0.45)"/>

      <path class="beam" d="M300 64 L440 26 L440 92 Z" fill="url(#beamGrad2)"/>
      <path class="beam beam-soft" d="M300 70 L440 96 L440 146 Z" fill="url(#beamGrad2)" opacity="0.45"/>

      <!-- carroçaria: coupé executivo baixo, capô longo, tejadilho recuado -->
      <path d="M14 74
               C 15 63 26 56 38 55
               L 66 54
               C 78 34 100 22 130 21
               L 178 22
               C 202 24 218 36 226 54
               L 278 55
               C 296 56 312 62 320 76
               C 322 81 320 87 314 89
               L 300 89
               C 297 96 288 100 278 100
               C 268 100 259 96 256 89
               L 100 89
               C 97 96 88 100 78 100
               C 68 100 59 96 56 89
               L 26 89
               C 18 87 12 82 14 74 Z"
            fill="url(#bodyGrad)" stroke="#3d7dfb" stroke-width="1.6"/>

      <!-- vinco lateral -->
      <path d="M40 56 L288 58" stroke="#5c93fc" stroke-width="1" opacity="0.3"/>
      <path d="M40 66 L288 68" stroke="#050810" stroke-width="1" opacity="0.4"/>

      <!-- vidros: para-brisas + laterais + traseira -->
      <path d="M132 26 C 156 24 178 25 190 27 C 204 30 216 40 222 52 L 132 52 C 128 44 128 34 132 26 Z"
            fill="url(#glassGrad)"/>
      <line x1="178" y1="26" x2="178" y2="52" stroke="#080e18" stroke-width="1.3" opacity="0.55"/>

      <!-- puxador -->
      <rect x="150" y="58" width="14" height="3" rx="1.5" fill="#5c93fc" opacity="0.6"/>

      <!-- badge -->
      <circle cx="304" cy="70" r="3" fill="none" stroke="#8ea6d6" stroke-width="1" opacity="0.7"/>

      <!-- rodas com jantes -->
      <circle cx="82" cy="89" r="18" fill="url(#wheelGrad)" stroke="#b9c4d6" stroke-width="2"/>
      <g stroke="#8a94a8" stroke-width="1.2" opacity="0.8">
        <line x1="82" y1="89" x2="82" y2="75"/>
        <line x1="82" y1="89" x2="94" y2="82"/>
        <line x1="82" y1="89" x2="94" y2="96"/>
        <line x1="82" y1="89" x2="70" y2="96"/>
        <line x1="82" y1="89" x2="70" y2="82"/>
      </g>
      <circle cx="82" cy="89" r="4" fill="#1c2740"/>

      <circle cx="270" cy="89" r="18" fill="url(#wheelGrad)" stroke="#b9c4d6" stroke-width="2"/>
      <g stroke="#8a94a8" stroke-width="1.2" opacity="0.8">
        <line x1="270" y1="89" x2="270" y2="75"/>
        <line x1="270" y1="89" x2="282" y2="82"/>
        <line x1="270" y1="89" x2="282" y2="96"/>
        <line x1="270" y1="89" x2="258" y2="96"/>
        <line x1="270" y1="89" x2="258" y2="82"/>
      </g>
      <circle cx="270" cy="89" r="4" fill="#1c2740"/>

      <!-- luzes -->
      <ellipse cx="313" cy="70" rx="6.5" ry="4.2" fill="#ffe9b0"/>
      <ellipse cx="313" cy="70" rx="3" ry="2" fill="#fff6de"/>
      <ellipse cx="16" cy="70" rx="4.4" ry="3.4" fill="#ff5252" opacity="0.9"/>

      <!-- espelho -->
      <path d="M224 44 L233 41 L234 47 L225 49 Z" fill="#080e18" stroke="#3d7dfb" stroke-width="0.8"/>
    </svg>
  </div>

  <div class="hero-content">
    <p class="hero-eyebrow"><%= t('hero.eyebrow') %></p>
    <h1><%= t('hero.title1') %><br><%= t('hero.title2') %></h1>
    <p class="hero-lede"><%= t('hero.lede') %></p>
    <div class="hero-actions">
      <a href="/contacto" class="btn btn-primary" data-nav><%= t('hero.cta.reservar') %></a>
      <a href="/servicos" class="btn btn-ghost" data-nav><%= t('hero.cta.servicos') %></a>
    </div>
    <div class="hero-stats">
      <div><strong>24/7</strong><span><%= t('hero.stat.disponibilidade') %></span></div>
      <div><strong>+8 anos</strong><span><%= t('hero.stat.experiencia') %></span></div>
      <div><strong>100%</strong><span><%= t('hero.stat.pontualidade') %></span></div>
    </div>
  </div>
</section>

<section class="services-strip">
  <div class="strip-inner">
    <article class="strip-card">
      <h3><%= t('strip.aeroporto.title') %></h3>
      <p><%= t('strip.aeroporto.desc') %></p>
    </article>
    <article class="strip-card">
      <h3><%= t('strip.executivo.title') %></h3>
      <p><%= t('strip.executivo.desc') %></p>
    </article>
    <article class="strip-card">
      <h3><%= t('strip.eventos.title') %></h3>
      <p><%= t('strip.eventos.desc') %></p>
    </article>
  </div>
</section>

<section class="cta-band">
  <div class="cta-inner">
    <h2><%= t('cta.home.title') %></h2>
    <a href="/contacto" class="btn btn-primary" data-nav><%= t('cta.home.btn') %></a>
  </div>
</section>

<%- include('partials/footer') %>
</body>
</html>
