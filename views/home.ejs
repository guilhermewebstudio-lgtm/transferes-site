<!DOCTYPE html>
<html lang="pt">
<head>
<%- include('partials/head') %>
</head>
<body class="page-home">
<%- include('partials/nav') %>

<section class="hero">
  <div class="hero-scene" aria-hidden="true">
    <svg class="scene-sky" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMax slice">
      <defs>
        <linearGradient id="skyGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#040611"/>
          <stop offset="55%" stop-color="#060a17"/>
          <stop offset="100%" stop-color="#0b1424"/>
        </linearGradient>
        <linearGradient id="roadGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#0d1420"/>
          <stop offset="100%" stop-color="#161f30"/>
        </linearGradient>
        <radialGradient id="moonGlow" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#cfe0ff" stop-opacity="0.5"/>
          <stop offset="100%" stop-color="#cfe0ff" stop-opacity="0"/>
        </radialGradient>
      </defs>
      <rect width="1600" height="900" fill="url(#skyGrad)"/>
      <circle cx="1400" cy="110" r="70" fill="url(#moonGlow)"/>
      <circle cx="1400" cy="110" r="30" fill="#e7edf8"/>
      <circle cx="1391" cy="103" r="4" fill="#c7d2e0" opacity="0.5"/>
      <circle cx="1408" cy="116" r="3" fill="#c7d2e0" opacity="0.4"/>
      <g class="stars">
        <circle cx="120" cy="90" r="1.6" fill="#c7d2e0" opacity="0.6"/>
        <circle cx="260" cy="160" r="1.2" fill="#c7d2e0" opacity="0.5"/>
        <circle cx="420" cy="80" r="1.6" fill="#c7d2e0" opacity="0.7"/>
        <circle cx="700" cy="130" r="1.2" fill="#c7d2e0" opacity="0.4"/>
        <circle cx="980" cy="70" r="1.6" fill="#c7d2e0" opacity="0.6"/>
        <circle cx="1150" cy="200" r="1.2" fill="#c7d2e0" opacity="0.5"/>
      </g>
      <g class="skyline" fill="#0a1120">
        <rect x="60" y="520" width="60" height="240"/>
        <rect x="140" y="470" width="46" height="290"/>
        <rect x="200" y="560" width="80" height="200"/>
        <rect x="1180" y="500" width="70" height="260"/>
        <rect x="1270" y="440" width="50" height="320"/>
        <rect x="1340" y="540" width="90" height="220"/>
        <rect x="1440" y="490" width="55" height="270"/>
      </g>
      <g class="skyline-lights" fill="#3d7dfb" opacity="0.55">
        <rect x="72" y="540" width="6" height="6"/>
        <rect x="90" y="560" width="6" height="6"/>
        <rect x="160" y="500" width="6" height="6"/>
        <rect x="1200" y="530" width="6" height="6"/>
        <rect x="1290" y="470" width="6" height="6"/>
        <rect x="1360" y="570" width="6" height="6"/>
      </g>
    </svg>

    <svg class="scene-road" viewBox="0 0 1600 500" preserveAspectRatio="xMidYMax slice">
      <polygon points="600,0 1000,0 1560,500 40,500" fill="url(#roadGrad)"/>
      <polygon points="600,0 1000,0 1560,500 40,500" fill="none"/>
      <g class="lane-dashes">
        <polygon points="790,0 810,0 900,500 700,500" fill="#1c2740"/>
      </g>
      <g class="posts">
        <g class="post" style="--i:0"><rect x="120" y="260" width="6" height="90" fill="#1a2438"/><circle cx="123" cy="256" r="7" fill="#ffe9b0" opacity="0.85"/></g>
        <g class="post" style="--i:1"><rect x="1470" y="260" width="6" height="90" fill="#1a2438"/><circle cx="1473" cy="256" r="7" fill="#ffe9b0" opacity="0.85"/></g>
        <g class="post" style="--i:2"><rect x="260" y="330" width="7" height="120" fill="#1a2438"/><circle cx="263" cy="325" r="8" fill="#ffe9b0" opacity="0.85"/></g>
        <g class="post" style="--i:3"><rect x="1330" y="330" width="7" height="120" fill="#1a2438"/><circle cx="1333" cy="325" r="8" fill="#ffe9b0" opacity="0.85"/></g>
      </g>
    </svg>

    <svg class="scene-car" id="hero-car" viewBox="0 0 320 120" width="320" height="120">
      <defs>
        <linearGradient id="beamGrad2" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="#ffe9b0" stop-opacity="0.55"/>
          <stop offset="100%" stop-color="#ffe9b0" stop-opacity="0"/>
        </linearGradient>
        <linearGradient id="bodyGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#1a2740"/>
          <stop offset="55%" stop-color="#101a2b"/>
          <stop offset="100%" stop-color="#0a121f"/>
        </linearGradient>
        <linearGradient id="glassGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#8ea6d6" stop-opacity="0.4"/>
          <stop offset="100%" stop-color="#3d7dfb" stop-opacity="0.12"/>
        </linearGradient>
      </defs>

      <ellipse class="car-shadow" cx="165" cy="103" rx="118" ry="7" fill="rgba(0,0,0,0.45)"/>

      <path class="beam" d="M282 68 L420 30 L420 96 Z" fill="url(#beamGrad2)"/>
      <path class="beam beam-soft" d="M282 74 L420 100 L420 150 Z" fill="url(#beamGrad2)" opacity="0.45"/>

      <path d="M18 76
               C 20 66 30 60 40 59
               L 70 58
               C 80 40 96 27 116 25
               L 190 25
               C 212 27 228 41 236 58
               L 262 59
               C 278 60 292 66 298 78
               C 300 82 299 88 294 90
               L 282 90
               C 279 96 271 100 262 100
               C 253 100 245 96 242 90
               L 96 90
               C 93 96 85 100 76 100
               C 67 100 59 96 56 90
               L 30 90
               C 22 89 16 84 18 76 Z"
            fill="url(#bodyGrad)" stroke="#3d7dfb" stroke-width="1.6"/>

      <path d="M40 60 L272 62" stroke="#5c93fc" stroke-width="1" opacity="0.35"/>

      <path d="M120 30 C 132 29 178 29 188 30 C 200 32 210 42 215 54 L 122 54 C 118 46 117 37 120 30 Z"
            fill="url(#glassGrad)"/>
      <line x1="167" y1="30" x2="167" y2="54" stroke="#0a121f" stroke-width="1.4" opacity="0.6"/>

      <circle cx="76" cy="90" r="17" fill="#070b12" stroke="#b9c4d6" stroke-width="2"/>
      <circle cx="76" cy="90" r="7" fill="#1c2740" stroke="#8a94a8" stroke-width="1"/>
      <circle cx="262" cy="90" r="17" fill="#070b12" stroke="#b9c4d6" stroke-width="2"/>
      <circle cx="262" cy="90" r="7" fill="#1c2740" stroke="#8a94a8" stroke-width="1"/>

      <ellipse cx="292" cy="72" rx="6" ry="4" fill="#ffe9b0"/>
      <ellipse cx="21" cy="72" rx="4" ry="3.4" fill="#ff5252" opacity="0.9"/>

      <path d="M214 46 L222 43 L223 49 L215 51 Z" fill="#0a121f" stroke="#3d7dfb" stroke-width="0.8"/>
    </svg>
  </div>

  <div class="hero-content">
    <p class="hero-eyebrow">Transfers executivos &amp; aeroporto</p>
    <h1>Chega a horas.<br>Chegue em estilo.</h1>
    <p class="hero-lede">Condutores profissionais, viaturas cuidadas ao detalhe e uma reserva que demora menos de um minuto — para quem não pode deixar nada ao acaso.</p>
    <div class="hero-actions">
      <a href="/contacto" class="btn btn-primary" data-nav>Reservar transfer</a>
      <a href="/servicos" class="btn btn-ghost" data-nav>Ver serviços</a>
    </div>
    <div class="hero-stats">
      <div><strong>24/7</strong><span>Disponibilidade</span></div>
      <div><strong>+8 anos</strong><span>De experiência</span></div>
      <div><strong>100%</strong><span>Pontualidade</span></div>
    </div>
  </div>
</section>

<section class="services-strip">
  <div class="strip-inner">
    <article class="strip-card">
      <h3>Aeroporto</h3>
      <p>Monitorização do voo em tempo real, espera incluída e recolha de bagagem sem pressas.</p>
    </article>
    <article class="strip-card">
      <h3>Executivo</h3>
      <p>Deslocações profissionais com discrição, wi-fi a bordo e viaturas de gama alta.</p>
    </article>
    <article class="strip-card">
      <h3>Eventos privados</h3>
      <p>Casamentos, jantares e ocasiões especiais tratadas com o mesmo rigor de sempre.</p>
    </article>
  </div>
</section>

<section class="cta-band">
  <div class="cta-inner">
    <h2>Marque a sua viagem em menos de um minuto</h2>
    <a href="/contacto" class="btn btn-primary" data-nav>Fazer reserva</a>
  </div>
</section>

<%- include('partials/footer') %>
</body>
</html>
