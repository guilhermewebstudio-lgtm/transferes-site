<!DOCTYPE html>
<html lang="pt">
<head>
<%- include('../partials/head') %>
</head>
<body>
<%- include('../partials/nav') %>

<section class="auth-section">
  <div class="auth-card">
    <img src="/img/srride-full.png" alt="SR Ride" class="auth-card-logo">
    <p class="auth-card-eyebrow"><%= t('auth.eyebrow_conta') %></p>
    <h1 class="auth-card-title"><%= t('auth.recuperar_title') %></h1>
    <p class="auth-card-desc"><%= t('auth.recuperar_desc') %></p>

    <% if (erro) { %><p class="form-feedback error"><%= erro %></p><% } %>
    <% if (sucesso) { %><p class="form-feedback success"><%= sucesso %></p><% } %>

    <% if (!sucesso) { %>
    <form method="POST" action="/esqueci-password" class="booking-form">
      <label>Email<input type="email" name="email" required autofocus></label>
      <button type="submit" class="btn btn-primary auth-submit"><%= t('auth.enviar_link_btn') %></button>
    </form>
    <% } %>

    <p class="auth-switch"><a href="/login" data-nav><%= t('auth.voltar_login') %></a></p>
  </div>
</section>

<%- include('../partials/footer') %>
</body>
</html>
