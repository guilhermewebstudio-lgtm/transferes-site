<!DOCTYPE html>
<html lang="pt">
<head>
<%- include('../partials/head') %>
</head>
<body>
<%- include('../partials/nav') %>
<section class="page-hero" style="padding-bottom:0;">
  <p class="hero-eyebrow">A tua conta</p>
  <h1>Recuperar password</h1>
  <p class="page-lede">Indica o email da tua conta e enviamos-te um link para escolheres uma nova password.</p>
</section>
<section class="booking-section" style="max-width:420px;">
  <% if (erro) { %><p class="form-feedback error"><%= erro %></p><% } %>
  <% if (sucesso) { %><p class="form-feedback success"><%= sucesso %></p><% } %>
  <% if (!sucesso) { %>
  <form method="POST" action="/esqueci-password" class="booking-form">
    <label>Email<input type="email" name="email" required autofocus></label>
    <button type="submit" class="btn btn-primary">Enviar link</button>
  </form>
  <% } %>
  <p style="margin-top:20px;color:var(--muted);"><a href="/login" data-nav style="color:var(--blue);">Voltar ao login</a></p>
</section>
<%- include('../partials/footer') %>
</body>
</html>
