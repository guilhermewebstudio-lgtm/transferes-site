<!DOCTYPE html>
<html lang="pt">
<head>
<%- include('../partials/head') %>
</head>
<body>
<%- include('../partials/nav') %>

<section class="auth-section">
  <div class="auth-card">
    <img src="/img/srride-full.png" alt="SR Ride" class="auth-card-logo">
    <p class="auth-card-eyebrow">A tua conta</p>
    <h1 class="auth-card-title">Recuperar password</h1>
    <p class="auth-card-desc">Indica o email da tua conta e enviamos-te um link para escolheres uma nova password.</p>

    <% if (erro) { %><p class="form-feedback error"><%= erro %></p><% } %>
    <% if (sucesso) { %><p class="form-feedback success"><%= sucesso %></p><% } %>

    <% if (!sucesso) { %>
    <form method="POST" action="/esqueci-password" class="booking-form">
      <label>Email<input type="email" name="email" required autofocus></label>
      <button type="submit" class="btn btn-primary auth-submit">Enviar link</button>
    </form>
    <% } %>

    <p class="auth-switch"><a href="/login" data-nav>Voltar ao login</a></p>
  </div>
</section>

<%- include('../partials/footer') %>
</body>
</html>
