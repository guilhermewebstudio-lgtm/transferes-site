<!DOCTYPE html>
<html lang="pt">
<head>
<%- include('../partials/head') %>
</head>
<body>
<%- include('../partials/nav') %>
<section class="page-hero" style="padding-bottom:0;">
  <p class="hero-eyebrow">A tua conta</p>
  <h1>Criar conta</h1>
</section>
<section class="booking-section" style="max-width:420px;">
  <% if (erro) { %><p class="form-feedback error"><%= erro %></p><% } %>
  <form method="POST" action="/registo" class="booking-form">
    <label>Nome<input type="text" name="nome" required></label>
    <label>Email<input type="email" name="email" required></label>
    <label>Password<input type="password" name="password" minlength="6" required></label>
    <button type="submit" class="btn btn-primary">Criar conta</button>
  </form>
  <p style="margin-top:20px;color:var(--muted);">Já tens conta? <a href="/login" data-nav style="color:var(--blue);">Entrar</a></p>
</section>
<%- include('../partials/footer') %>
</body>
</html>
