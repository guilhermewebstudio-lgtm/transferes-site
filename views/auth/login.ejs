<!DOCTYPE html>
<html lang="pt">
<head>
<%- include('../partials/head') %>
</head>
<body>
<%- include('../partials/nav') %>
<section class="page-hero" style="padding-bottom:0;">
  <p class="hero-eyebrow">A tua conta</p>
  <h1>Entrar</h1>
</section>
<section class="booking-section" style="max-width:420px;">
  <% if (erro) { %><p class="form-feedback error"><%= erro %></p><% } %>
  <form method="POST" action="/login" class="booking-form">
    <input type="hidden" name="next" value="<%= next %>">
    <label>Email<input type="email" name="email" required></label>
    <label>Password
      <div class="pw-field">
        <input type="password" name="password" class="pw-input" required>
        <button type="button" class="pw-toggle" aria-label="Mostrar password">
          <svg class="pw-eye-open" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8Z"/><circle cx="12" cy="12" r="3"/></svg>
          <svg class="pw-eye-closed" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;"><path d="M17.94 17.94A10.94 10.94 0 0 1 12 20c-7 0-11-8-11-8a20.3 20.3 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a20.29 20.29 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
        </button>
      </div>
    </label>
    <button type="submit" class="btn btn-primary">Entrar</button>
  </form>
  <p style="margin-top:14px;"><a href="/esqueci-password" data-nav style="color:var(--muted); font-size:0.9rem;">Esqueci-me da password</a></p>
  <p style="margin-top:20px;color:var(--muted);">Ainda não tens conta? <a href="/registo" data-nav style="color:var(--blue);">Criar conta</a></p>
</section>
<%- include('../partials/footer') %>
</body>
</html>
