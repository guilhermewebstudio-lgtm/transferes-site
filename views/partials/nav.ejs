<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand" data-nav>
      <svg class="brand-mark" viewBox="0 0 64 64" width="34" height="34" xmlns="http://www.w3.org/2000/svg">
        <circle cx="32" cy="32" r="27" fill="none" stroke="#c9a16a" stroke-width="2"/>
        <path d="M32 3v7M32 54v7M3 32h7M54 32h7" stroke="#c9a16a" stroke-width="2" stroke-linecap="round"/>
        <text x="32" y="40" font-family="'Unbounded', sans-serif" font-size="20" font-weight="600" fill="#c9a16a" text-anchor="middle">SR</text>
      </svg>
      <span class="brand-word">SR Transferes</span>
    </a>
    <nav class="main-nav">
      <a href="/servicos" data-nav><%= t('nav.servicos') %></a>
      <a href="/frota" data-nav><%= t('nav.frota') %></a>
      <a href="/precos-horarios" data-nav>Preços</a>
      <a href="/simulador" data-nav>Simulador</a>
      <a href="/sobre" data-nav><%= t('nav.sobre') %></a>

      <% if (typeof user !== 'undefined' && user) { %>
        <div class="account-menu">
          <button type="button" class="account-menu-toggle">
            <%= user.nome ? user.nome.split(' ')[0] : t('nav.conta') %>
            <svg viewBox="0 0 12 8" width="10" height="7" fill="none"><path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="account-menu-dropdown">
            <% if (user.is_admin) { %><a href="/admin" data-nav><%= t('nav.admin') %></a><% } %>
            <a href="/minhas-reservas" data-nav>Reservas</a>
            <a href="/suporte" data-nav>Suporte</a>
            <a href="/conta" data-nav><%= t('nav.conta') %></a>
          </div>
        </div>
      <% } else { %>
        <a href="/login" data-nav><%= t('nav.entrar') %></a>
      <% } %>

      <div class="lang-switch" role="group" aria-label="Idioma">
        <a href="/lang/pt" class="lang-btn <%= lang === 'pt' ? 'active' : '' %>">PT</a>
        <a href="/lang/en" class="lang-btn <%= lang === 'en' ? 'active' : '' %>">EN</a>
      </div>
      <a href="/contacto" class="nav-cta" data-nav><%= t('nav.reservar') %></a>
    </nav>
    <button class="nav-toggle" aria-label="Abrir menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
  <div class="mobile-nav">
    <a href="/servicos" data-nav><%= t('nav.servicos') %></a>
    <a href="/frota" data-nav><%= t('nav.frota') %></a>
    <a href="/precos-horarios" data-nav>Preços</a>
    <a href="/simulador" data-nav>Simulador</a>
    <a href="/sobre" data-nav><%= t('nav.sobre') %></a>
    <% if (typeof user !== 'undefined' && user) { %>
      <% if (user.is_admin) { %><a href="/admin" data-nav><%= t('nav.admin') %></a><% } %>
      <a href="/minhas-reservas" data-nav>Reservas</a>
      <a href="/suporte" data-nav>Suporte</a>
      <a href="/conta" data-nav><%= t('nav.conta') %></a>
    <% } else { %>
      <a href="/login" data-nav><%= t('nav.entrar') %></a>
    <% } %>
    <a href="/contacto" data-nav><%= t('nav.reservar') %></a>
    <div class="lang-switch" role="group" aria-label="Idioma">
      <a href="/lang/pt" class="lang-btn <%= lang === 'pt' ? 'active' : '' %>">PT</a>
      <a href="/lang/en" class="lang-btn <%= lang === 'en' ? 'active' : '' %>">EN</a>
    </div>
  </div>
</header>
