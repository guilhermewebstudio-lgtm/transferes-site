<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand" data-nav>
      <span class="brand-mark">
        <svg viewBox="0 0 40 24" width="34" height="20" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M2 17c0-2 1.5-3.4 3.6-3.8L9 12.4l3-4.6c.6-.9 1.6-1.4 2.7-1.4h9.4c1.2 0 2.3.6 2.9 1.7l2.6 4.6 3.2.7c1.6.4 2.6 1.8 2.6 3.4v2.2c0 .9-.7 1.6-1.6 1.6H35" stroke="var(--silver)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="11" cy="18.4" r="2.4" stroke="var(--blue)" stroke-width="1.6"/>
          <circle cx="27" cy="18.4" r="2.4" stroke="var(--blue)" stroke-width="1.6"/>
          <path d="M2 17H7" stroke="var(--silver)" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </span>
      <span class="brand-word">Transferes</span>
    </a>
    <nav class="main-nav">
      <a href="/servicos" data-nav><%= t('nav.servicos') %></a>
      <a href="/frota" data-nav><%= t('nav.frota') %></a>
      <a href="/sobre" data-nav><%= t('nav.sobre') %></a>
      <% if (typeof user !== 'undefined' && user) { %>
        <% if (user.is_admin) { %><a href="/admin" data-nav><%= t('nav.admin') %></a><% } %>
        <a href="/conta" data-nav><%= t('nav.conta') %></a>
      <% } else { %>
        <a href="/login" data-nav><%= t('nav.entrar') %></a>
      <% } %>
      <div class="lang-switch" role="group" aria-label="Idioma">
        <a href="/lang/pt" class="lang-btn <%= lang === 'pt' ? 'active' : '' %>">PT</a>
        <a href="/lang/en" class="lang-btn <%= lang === 'en' ? 'active' : '' %>">EN</a>
      </div>
      <a href="/contacto" class="nav-cta" data-nav><%= t('nav.reservar') %></a>
    </nav>
    <button class="nav-toggle" aria-label="Abrir menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
  <div class="mobile-nav">
    <a href="/servicos" data-nav><%= t('nav.servicos') %></a>
    <a href="/frota" data-nav><%= t('nav.frota') %></a>
    <a href="/sobre" data-nav><%= t('nav.sobre') %></a>
    <% if (typeof user !== 'undefined' && user) { %>
      <% if (user.is_admin) { %><a href="/admin" data-nav><%= t('nav.admin') %></a><% } %>
      <a href="/conta" data-nav><%= t('nav.conta') %></a>
    <% } else { %>
      <a href="/login" data-nav><%= t('nav.entrar') %></a>
    <% } %>
    <a href="/contacto" data-nav><%= t('nav.reservar') %></a>
    <div class="lang-switch" role="group" aria-label="Idioma">
      <a href="/lang/pt" class="lang-btn <%= lang === 'pt' ? 'active' : '' %>">PT</a>
      <a href="/lang/en" class="lang-btn <%= lang === 'en' ? 'active' : '' %>">EN</a>
    </div>
  </div>
</header>
