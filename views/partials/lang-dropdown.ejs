<%
  const flagSvg = (codigo) => {
    if (codigo === 'pt') {
      return `<svg class="flag-icon" viewBox="0 0 30 20" xmlns="http://www.w3.org/2000/svg">
        <rect width="30" height="20" fill="#FF0000"/>
        <rect width="12" height="20" fill="#046A38"/>
        <circle cx="12" cy="10" r="4.6" fill="#FFCC00" stroke="#7d1c1c" stroke-width="0.4"/>
        <circle cx="12" cy="10" r="3.1" fill="none" stroke="#046A38" stroke-width="0.5"/>
        <path d="M9.3 10h5.4M12 7.3v5.4" stroke="#046A38" stroke-width="0.5"/>
      </svg>`;
    }
    if (codigo === 'en') {
      return `<svg class="flag-icon" viewBox="0 0 30 20" xmlns="http://www.w3.org/2000/svg">
        <rect width="30" height="20" fill="#00247D"/>
        <path d="M0,0 L30,20 M0,20 L30,0" stroke="#FFFFFF" stroke-width="4"/>
        <path d="M0,0 L30,20 M0,20 L30,0" stroke="#CF142B" stroke-width="1.6"/>
        <path d="M15,0 V20 M0,10 H30" stroke="#FFFFFF" stroke-width="6.6"/>
        <path d="M15,0 V20 M0,10 H30" stroke="#CF142B" stroke-width="4"/>
      </svg>`;
    }
    if (codigo === 'fr') {
      return `<svg class="flag-icon" viewBox="0 0 30 20" xmlns="http://www.w3.org/2000/svg">
        <rect width="10" height="20" x="0" fill="#0055A4"/>
        <rect width="10" height="20" x="10" fill="#fff"/>
        <rect width="10" height="20" x="20" fill="#EF4135"/>
      </svg>`;
    }
    return `<svg class="flag-icon" viewBox="0 0 30 20" xmlns="http://www.w3.org/2000/svg">
      <rect width="30" height="20" fill="#C60B1E"/>
      <rect width="30" height="10" y="5" fill="#FFC400"/>
      <g transform="translate(8,7)">
        <rect width="5.5" height="7" rx="0.6" fill="#AD1519" stroke="#8a6d0a" stroke-width="0.3"/>
        <rect width="2.75" height="3.5" fill="#FFC400"/>
        <rect x="2.75" y="3.5" width="2.75" height="3.5" fill="#FFC400"/>
        <path d="M0.8,-0.6 Q2.75,-1.6 4.7,-0.6 L4.2,0 L0.3,0 Z" fill="#FFC400" stroke="#8a6d0a" stroke-width="0.25"/>
      </g>
    </svg>`;
  };
  const nomesIdioma = { pt: 'Português', en: 'English', fr: 'Français', es: 'Español' };
%>
<div class="lang-dropdown">
  <button type="button" class="lang-dropdown-toggle" aria-label="Idioma">
    <span class="lang-flag"><%- flagSvg(lang) %></span>
    <span class="lang-code"><%= lang.toUpperCase() %></span>
    <svg viewBox="0 0 12 8" width="9" height="6" fill="none"><path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <div class="lang-dropdown-menu">
    <% ['pt','en','fr','es'].forEach((codigo) => { %>
      <a href="/lang/<%= codigo %>" class="lang-option <%= lang === codigo ? 'active' : '' %>">
        <%- flagSvg(codigo) %> <%= nomesIdioma[codigo] %>
      </a>
    <% }) %>
  </div>
</div>
