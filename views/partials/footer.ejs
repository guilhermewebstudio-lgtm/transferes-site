<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <span class="brand-word">SR Ride</span>
      <p><%= t('footer.tagline') %></p>
    </div>
    <div class="footer-cols">
      <div>
        <h4><%= t('footer.nav') %></h4>
        <a href="/servicos" data-nav><%= t('nav.servicos') %></a>
        <a href="/frota" data-nav><%= t('nav.frota') %></a>
        <a href="/sobre" data-nav><%= t('nav.sobre') %></a>
        <a href="/contacto" data-nav><%= t('nav.reservar') %></a>
      </div>
      <div>
        <h4><%= t('footer.contacto') %></h4>
        <a href="tel:+351900000000">+351 900 000 000</a>
        <a href="mailto:reservas@srride.pt">reservas@srride.pt</a>
        <span>Lisboa, Portugal</span>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <span>&copy; <%= new Date().getFullYear() %> SR Ride. <%= t('footer.rights') %></span>
  </div>
</footer>

<!-- Overlay de transição entre páginas -->
<div class="route-transition" aria-hidden="true"></div>

<script src="/js/main.js"></script>

<!-- Chatbot flutuante -->
<div class="social-fab-group">
  <a href="#" class="social-fab" aria-label="Instagram" onclick="return false;">
    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5.5"/><circle cx="12" cy="12" r="4.2"/><line x1="17.3" y1="6.7" x2="17.31" y2="6.7"/></svg>
  </a>
  <a href="#" class="social-fab" aria-label="TikTok" onclick="return false;">
    <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M16.6 5.82c-.9-.63-1.55-1.6-1.75-2.72h-3.05v13.44c0 1.62-1.32 2.94-2.94 2.94-.5 0-.98-.13-1.4-.35a2.94 2.94 0 0 1 1.4-5.53c.31 0 .6.05.88.13V10.6a5.94 5.94 0 0 0-.88-.07 5.95 5.95 0 1 0 5.15 8.9 5.9 5.9 0 0 0 .8-3v-6.65a7.5 7.5 0 0 0 4.4 1.41V8.14a4.55 4.55 0 0 1-2.61-.83z"/></svg>
  </a>
</div>

<div class="chat-widget" id="chat-widget">
  <button class="chat-toggle" id="chat-toggle" aria-label="Abrir assistente">
    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
    </svg>
  </button>
  <div class="chat-panel" id="chat-panel">
    <div class="chat-header">
      <span>Assistente SR Ride</span>
      <button id="chat-close" aria-label="Fechar">&times;</button>
    </div>
    <div class="chat-messages" id="chat-messages">
      <div class="chat-msg bot">Olá! Sou o assistente da SR Ride. Em que posso ajudar — dúvidas sobre serviços, frota ou como reservar?</div>
    </div>
    <form id="chat-form" class="chat-form">
      <input type="text" id="chat-input" placeholder="Escreve a tua mensagem..." autocomplete="off" required>
      <button type="submit" aria-label="Enviar">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
      </button>
    </form>
  </div>
</div>
<script src="/js/chat.js"></script>
