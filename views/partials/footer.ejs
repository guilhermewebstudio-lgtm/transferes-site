<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <span class="brand-word">Transferes</span>
      <p><%= t('footer.tagline') %></p>
    </div>
    <div class="footer-cols">
      <div>
        <h4><%= t('footer.nav') %></h4>
        <a href="/servicos" data-nav><%= t('nav.servicos') %></a>
        <a href="/frota" data-nav><%= t('nav.frota') %></a>
        <a href="/sobre" data-nav><%= t('nav.sobre') %></a>
        <a href="/contacto" data-nav><%= t('nav.reservar') %></a>
      </div>
      <div>
        <h4><%= t('footer.contacto') %></h4>
        <a href="tel:+351900000000">+351 900 000 000</a>
        <a href="mailto:reservas@transferes.pt">reservas@transferes.pt</a>
        <span>Lisboa, Portugal</span>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <span>&copy; <%= new Date().getFullYear() %> Transferes. <%= t('footer.rights') %></span>
  </div>
</footer>

<!-- Overlay de transição entre páginas -->
<div class="route-transition" aria-hidden="true">
  <svg class="transition-road" viewBox="0 0 1600 200" preserveAspectRatio="none">
    <rect x="0" y="0" width="1600" height="200" fill="var(--bg)"></rect>
    <line x1="0" y1="100" x2="1600" y2="100" class="dash-line"></line>
  </svg>
  <svg class="transition-car" viewBox="0 0 240 100" width="240" height="100">
    <defs>
      <linearGradient id="beamGrad" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="#ffe9b0" stop-opacity="0.6"/>
        <stop offset="100%" stop-color="#ffe9b0" stop-opacity="0"/>
      </linearGradient>
      <linearGradient id="transBodyGrad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#1a2740"/>
        <stop offset="55%" stop-color="#101a2b"/>
        <stop offset="100%" stop-color="#0a121f"/>
      </linearGradient>
    </defs>
    <ellipse cx="124" cy="86" rx="98" ry="6" fill="rgba(0,0,0,0.45)"></ellipse>
    <path class="headlight-beam" d="M212 55 L340 22 L340 82 Z" fill="url(#beamGrad)"></path>
    <path d="M14 63
             C 16 55 24 50 32 49
             L 55 48
             C 63 33 76 22 92 21
             L 150 21
             C 168 22 181 34 187 48
             L 208 49
             C 221 50 232 55 237 65
             C 239 68 238 73 234 75
             L 224 75
             C 222 80 216 83 209 83
             C 202 83 196 80 194 75
             L 78 75
             C 76 80 70 83 63 83
             C 56 83 50 80 48 75
             L 26 75
             C 20 74 12 70 14 63 Z"
          fill="url(#transBodyGrad)" stroke="var(--blue)" stroke-width="1.4"></path>
    <path d="M96 25 C 106 24 142 24 150 25 C 160 27 168 35 172 45 L 98 45 C 95 39 94 32 96 25 Z" fill="rgba(180,200,230,0.16)"></path>
    <circle cx="62" cy="75" r="14" fill="#070b12" stroke="var(--silver)" stroke-width="1.6"></circle>
    <circle cx="62" cy="75" r="5.5" fill="#1c2740"></circle>
    <circle cx="209" cy="75" r="14" fill="#070b12" stroke="var(--silver)" stroke-width="1.6"></circle>
    <circle cx="209" cy="75" r="5.5" fill="#1c2740"></circle>
    <ellipse cx="233" cy="60" rx="5" ry="3.4" fill="#ffe9b0"></ellipse>
    <ellipse cx="17" cy="60" rx="3.4" ry="2.8" fill="#ff5252" opacity="0.9"></ellipse>
  </svg>
</div>

<script src="/js/main.js"></script>

<!-- Chatbot flutuante -->
<div class="chat-widget" id="chat-widget">
  <button class="chat-toggle" id="chat-toggle" aria-label="Abrir assistente">
    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
    </svg>
  </button>
  <div class="chat-panel" id="chat-panel">
    <div class="chat-header">
      <span>Assistente Transferes</span>
      <button id="chat-close" aria-label="Fechar">&times;</button>
    </div>
    <div class="chat-messages" id="chat-messages">
      <div class="chat-msg bot">Olá! Sou o assistente da Transferes. Em que posso ajudar — dúvidas sobre serviços, frota ou como reservar?</div>
    </div>
    <form id="chat-form" class="chat-form">
      <input type="text" id="chat-input" placeholder="Escreve a tua mensagem..." autocomplete="off" required>
      <button type="submit" aria-label="Enviar">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
      </button>
    </form>
  </div>
</div>
<script src="/js/chat.js"></script>
