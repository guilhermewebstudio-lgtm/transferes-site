<div class="chat-widget" id="chat-widget">
  <button class="chat-toggle" id="chat-toggle" aria-label="Abrir assistente">
    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
    </svg>
  </button>
  <div class="chat-panel" id="chat-panel">
    <div class="chat-header">
      <span>Assistente SR Ride</span>
      <button id="chat-close" aria-label="Fechar">&times;</button>
    </div>
    <div class="chat-messages" id="chat-messages">
      <div class="chat-msg bot">Olá! Sou o assistente da SR Ride. Em que posso ajudar — dúvidas sobre serviços, frota ou como reservar?</div>
    </div>
    <form id="chat-form" class="chat-form">
      <input type="text" id="chat-input" placeholder="Escreve a tua mensagem..." autocomplete="off" required>
      <button type="submit" aria-label="Enviar">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
      </button>
    </form>
  </div>
</div>
<script src="/js/chat.js"></script>
