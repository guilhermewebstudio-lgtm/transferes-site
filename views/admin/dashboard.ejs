<!DOCTYPE html>
<html lang="pt">
<head>
<%- include('../partials/head') %>
</head>
<body>
<%- include('../partials/nav') %>
<section class="page-hero" style="padding-bottom:0;">
  <p class="hero-eyebrow">Painel</p>
  <h1>Admin</h1>
  <p class="page-lede"><%= totalUsers %> utilizadores registados · <%= reservas.length %> reservas recentes</p>
  <a href="/admin/suporte" class="btn btn-ghost" data-nav style="margin-top:16px; display:inline-flex;">Ver tickets de suporte</a>
</section>
<section class="booking-section" style="max-width:1100px;">
  <div style="overflow-x:auto;">
    <table style="width:100%;border-collapse:collapse;font-size:0.9rem;">
      <thead>
        <tr style="text-align:left;color:var(--muted);border-bottom:1px solid rgba(185,196,214,0.15);">
          <th style="padding:10px;">Nome</th>
          <th style="padding:10px;">Contacto</th>
          <th style="padding:10px;">Serviço</th>
          <th style="padding:10px;">Trajeto</th>
          <th style="padding:10px;">Data</th>
          <th style="padding:10px;">Estado</th>
        </tr>
      </thead>
      <tbody>
        <% reservas.forEach(r => { %>
        <tr style="border-bottom:1px solid rgba(185,196,214,0.06);">
          <td style="padding:10px;"><%= r.nome %></td>
          <td style="padding:10px;color:var(--muted);"><%= r.email %><br><%= r.telefone || '' %></td>
          <td style="padding:10px;"><%= r.tipo_servico %></td>
          <td style="padding:10px;color:var(--muted);"><%= r.origem %> → <%= r.destino %></td>
          <td style="padding:10px;color:var(--muted);"><%= r.data_hora ? new Date(r.data_hora).toLocaleString('pt-PT') : '-' %></td>
          <td style="padding:10px;">
            <div style="display:flex; gap:8px; align-items:center;">
              <form method="POST" action="/admin/reservas/<%= r.id %>/estado" style="display:flex;">
                <select name="estado" onchange="this.form.submit()" style="padding:6px;font-size:0.85rem;">
                  <option value="pendente" <%= r.estado === 'pendente' ? 'selected' : '' %>>Pendente</option>
                  <option value="confirmada" <%= r.estado === 'confirmada' ? 'selected' : '' %>>Confirmada</option>
                  <option value="concluida" <%= r.estado === 'concluida' ? 'selected' : '' %>>Concluída</option>
                  <option value="cancelada" <%= r.estado === 'cancelada' ? 'selected' : '' %>>Cancelada</option>
                </select>
              </form>
              <a href="/admin/reservas/<%= r.id %>/responder" data-nav style="font-size:0.85rem; color:var(--blue); white-space:nowrap;">Responder</a>
            </div>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
<%- include('../partials/footer') %>
</body>
</html>
