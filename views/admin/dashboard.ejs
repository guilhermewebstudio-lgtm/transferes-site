<!DOCTYPE html>
<html lang="pt">
<head>
<%- include('../partials/head') %>
</head>
<body>
<%- include('../partials/nav') %>
<section class="page-hero" style="padding-bottom:0;">
  <p class="hero-eyebrow">Painel</p>
  <h1>Admin</h1>
</section>

<section class="admin-panel">
  <div class="admin-stats">
    <div class="admin-stat-card">
      <span class="admin-stat-value"><%= totalUsers %></span>
      <span class="admin-stat-label">Utilizadores</span>
    </div>
    <div class="admin-stat-card">
      <span class="admin-stat-value"><%= reservas.length %></span>
      <span class="admin-stat-label">Reservas recentes</span>
    </div>
    <div class="admin-stat-card">
      <span class="admin-stat-value"><%= reservasPendentes %></span>
      <span class="admin-stat-label">Reservas pendentes</span>
    </div>
    <div class="admin-stat-card">
      <span class="admin-stat-value"><%= ticketsAbertos %></span>
      <span class="admin-stat-label">Tickets abertos</span>
    </div>
  </div>

  <div class="admin-quick-links">
    <a href="/admin/suporte" data-nav class="admin-quick-link">
      <strong>Suporte</strong>
      <span>Ver e responder a tickets</span>
    </a>
    <a href="/admin/conteudo" data-nav class="admin-quick-link">
      <strong>Conteúdo do site</strong>
      <span>Editar preços e horários</span>
    </a>
  </div>

  <div class="admin-section-header">
    <h2>Reservas</h2>
  </div>

  <div style="overflow-x:auto;">
    <table style="width:100%;border-collapse:collapse;font-size:0.9rem;">
      <thead>
        <tr style="text-align:left;color:var(--muted);border-bottom:1px solid rgba(185,196,214,0.15);">
          <th style="padding:10px;">Nome</th>
          <th style="padding:10px;">Contacto</th>
          <th style="padding:10px;">Serviço</th>
          <th style="padding:10px;">Trajeto</th>
          <th style="padding:10px;">Data</th>
          <th style="padding:10px;">Estado</th>
          <th style="padding:10px;">Ações</th>
        </tr>
      </thead>
      <tbody>
        <% reservas.forEach(r => { %>
        <tr style="border-bottom:1px solid rgba(185,196,214,0.06);">
          <td style="padding:10px;"><%= r.nome %></td>
          <td style="padding:10px;color:var(--muted);"><%= r.email %><br><%= r.telefone || '' %></td>
          <td style="padding:10px;"><%= r.tipo_servico %></td>
          <td style="padding:10px;color:var(--muted);"><%= r.origem %> → <%= r.destino %></td>
          <td style="padding:10px;color:var(--muted);"><%= r.data_hora ? new Date(r.data_hora).toLocaleString('pt-PT', { timeZone: 'Europe/Lisbon' }) : '-' %></td>
          <td style="padding:10px;">
            <form method="POST" action="/admin/reservas/<%= r.id %>/estado" style="display:flex;">
              <select name="estado" onchange="this.form.submit()" style="padding:6px;font-size:0.85rem;">
                <option value="pendente" <%= r.estado === 'pendente' ? 'selected' : '' %>>Pendente</option>
                <option value="confirmada" <%= r.estado === 'confirmada' ? 'selected' : '' %>>Confirmada</option>
                <option value="concluida" <%= r.estado === 'concluida' ? 'selected' : '' %>>Concluída</option>
                <option value="cancelada" <%= r.estado === 'cancelada' ? 'selected' : '' %>>Cancelada</option>
              </select>
            </form>
          </td>
          <td style="padding:10px;">
            <div style="display:flex; gap:10px; align-items:center;">
              <a href="/admin/reservas/<%= r.id %>/responder" data-nav style="font-size:0.85rem; color:var(--blue); white-space:nowrap;">Responder</a>
              <form method="POST" action="/admin/reservas/<%= r.id %>/apagar" onsubmit="return confirm('Apagar esta reserva? Esta ação não pode ser desfeita.');" style="display:flex;">
                <button type="submit" style="font-size:0.85rem; color:#ff8a8a; white-space:nowrap; background:none; border:none; cursor:pointer; padding:0;">Apagar</button>
              </form>
            </div>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

<%- include('../partials/footer') %>
</body>
</html>
