<!DOCTYPE html>
<html lang="pt">
<head>
<%- include('../partials/head') %>
</head>
<body>
<%- include('../partials/nav') %>
<section class="page-hero" style="padding-bottom:0;">
  <p class="hero-eyebrow">Admin · <a href="/admin" data-nav style="color:var(--blue);">voltar ao painel</a></p>
  <h1>Suporte</h1>
  <p class="page-lede"><%= tickets.length %> tickets no total</p>
</section>

<section class="booking-section" style="max-width:900px;">
  <% if (tickets.length === 0) { %>
    <p style="color:var(--muted);">Ainda não há tickets de suporte.</p>
  <% } else { %>
    <div style="display:flex; flex-direction:column; gap:14px;">
      <% tickets.forEach(t => { %>
        <a href="/suporte/<%= t.id %>" data-nav style="text-decoration:none;">
          <div style="background:var(--surface); border:1px solid rgba(185,196,214,0.1); border-radius:14px; padding:18px 20px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
            <div>
              <strong style="color:var(--text); font-size:0.98rem;"><%= t.assunto %></strong>
              <p style="margin:4px 0 0; color:var(--muted); font-size:0.85rem;"><%= t.user_nome %> · <%= t.user_email %></p>
            </div>
            <span style="padding:5px 14px; border-radius:999px; font-size:0.8rem; font-weight:600;
              background: <%= t.estado === 'fechado' ? 'rgba(185,196,214,0.12)' : 'rgba(61,125,251,0.15)' %>;
              color: <%= t.estado === 'fechado' ? 'var(--silver)' : 'var(--blue)' %>;">
              <%= t.estado === 'fechado' ? 'Fechado' : 'Aberto' %>
            </span>
          </div>
        </a>
      <% }) %>
    </div>
  <% } %>
</section>

<%- include('../partials/footer') %>
</body>
</html>
