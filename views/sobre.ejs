<!DOCTYPE html>
<html lang="pt">
<head>
<%- include('partials/head') %>
</head>
<body>
<%- include('partials/nav') %>

<section class="page-hero">
  <p class="hero-eyebrow"><%= t('page.sobre.eyebrow') %></p>
  <h1><%= t('page.sobre.title') %></h1>
  <p class="page-lede"><%= t('page.sobre.lede') %></p>
</section>

<section class="about-content">
  <div class="about-text">
    <p><%= t('sobre.p1') %></p>
    <p><%= t('sobre.p2') %></p>
  </div>
</section>

<section class="values-grid">
  <div class="value-item">
    <h3><%= t('sobre.valor1.title') %></h3>
    <p><%= t('sobre.valor1.desc') %></p>
  </div>
  <div class="value-item">
    <h3><%= t('sobre.valor2.title') %></h3>
    <p><%= t('sobre.valor2.desc') %></p>
  </div>
  <div class="value-item">
    <h3><%= t('sobre.valor3.title') %></h3>
    <p><%= t('sobre.valor3.desc') %></p>
  </div>
</section>

<section class="cta-band">
  <div class="cta-inner">
    <h2><%= t('cta.sobre.title') %></h2>
    <a href="/contacto" class="btn btn-primary" data-nav><%= t('hero.cta.reservar') %></a>
  </div>
</section>

<%- include('partials/footer') %>
</body>
</html>
