<!DOCTYPE html>
<html lang="pt">
<head>
<%- include('partials/head') %>
</head>
<body>
<%- include('partials/nav') %>

<section class="page-hero">
  <p class="hero-eyebrow"><%= t('page.frota.eyebrow') %></p>
  <h1><%= t('page.frota.title') %></h1>
  <p class="page-lede"><%= t('page.frota.lede') %></p>
</section>

<section class="fleet-grid">
  <article class="fleet-card">
    <div class="fleet-visual" aria-hidden="true">
      <svg viewBox="0 0 260 140"><rect width="260" height="140" rx="16" fill="#0c1420"/><path d="M30 90 C34 68 50 56 68 55 L192 55 C210 56 226 68 230 88 L230 92 C230 96 226 98 222 98 L38 98 C34 98 30 96 30 92 Z" fill="#101a2b" stroke="#c9a16a" stroke-width="1.6"/><circle cx="70" cy="98" r="12" fill="#080c14" stroke="#b9c4d6" stroke-width="1.4"/><circle cx="190" cy="98" r="12" fill="#080c14" stroke="#b9c4d6" stroke-width="1.4"/></svg>
    </div>
    <h3><%= t('frota.sedan.title') %></h3>
    <p><%= t('frota.sedan.desc') %></p>
  </article>
  <article class="fleet-card">
    <div class="fleet-visual" aria-hidden="true">
      <svg viewBox="0 0 260 140"><rect width="260" height="140" rx="16" fill="#0c1420"/><path d="M26 88 C30 60 48 50 66 50 L194 50 C212 50 230 60 234 88 L234 94 C234 98 230 100 226 100 L34 100 C30 100 26 98 26 94 Z" fill="#101a2b" stroke="#b9c4d6" stroke-width="1.6"/><circle cx="70" cy="100" r="13" fill="#080c14" stroke="#c9a16a" stroke-width="1.4"/><circle cx="190" cy="100" r="13" fill="#080c14" stroke="#c9a16a" stroke-width="1.4"/></svg>
    </div>
    <h3><%= t('frota.suv.title') %></h3>
    <p><%= t('frota.suv.desc') %></p>
  </article>
  <article class="fleet-card">
    <div class="fleet-visual" aria-hidden="true">
      <svg viewBox="0 0 260 140"><rect width="260" height="140" rx="16" fill="#0c1420"/><rect x="30" y="55" width="200" height="40" rx="8" fill="#101a2b" stroke="#ffe9b0" stroke-width="1.6"/><circle cx="70" cy="98" r="12" fill="#080c14" stroke="#b9c4d6" stroke-width="1.4"/><circle cx="140" cy="98" r="12" fill="#080c14" stroke="#b9c4d6" stroke-width="1.4"/><circle cx="200" cy="98" r="12" fill="#080c14" stroke="#b9c4d6" stroke-width="1.4"/></svg>
    </div>
    <h3><%= t('frota.van.title') %></h3>
    <p><%= t('frota.van.desc') %></p>
  </article>
</section>

<section class="cta-band">
  <div class="cta-inner">
    <h2><%= t('cta.frota.title') %></h2>
    <a href="/contacto" class="btn btn-primary" data-nav><%= t('cta.frota.btn') %></a>
  </div>
</section>

<%- include('partials/footer') %>
</body>
</html>
