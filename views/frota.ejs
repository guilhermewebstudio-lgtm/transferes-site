<!DOCTYPE html>
<html lang="pt">
<head>
<%- include('partials/head') %>
</head>
<body>
<%- include('partials/nav') %>

<section class="page-hero">
  <p class="hero-eyebrow"><%= t('page.frota.eyebrow') %></p>
  <h1><%= t('page.frota.title') %></h1>
  <p class="page-lede"><%= t('page.frota.lede') %></p>
</section>

<section class="fleet-grid">
  <article class="fleet-card">
    <div class="fleet-card-icon">
      <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 17h14M6 17l1.5-5.5a2 2 0 0 1 2-1.5h5a2 2 0 0 1 2 1.5L18 17M5 17a2 2 0 1 0 4 0M15 17a2 2 0 1 0 4 0"/></svg>
    </div>
    <h3><%= t('frota.sedan.title') %></h3>
    <p><%= t('frota.sedan.desc') %></p>
  </article>
  <article class="fleet-card">
    <div class="fleet-card-icon">
      <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 17h16M5 17l1-6a2 2 0 0 1 2-1.6h8a2 2 0 0 1 2 1.6l1 6M4 17a2 2 0 1 0 4 0M16 17a2 2 0 1 0 4 0M6 9.4h12"/></svg>
    </div>
    <h3><%= t('frota.suv.title') %></h3>
    <p><%= t('frota.suv.desc') %></p>
  </article>
  <article class="fleet-card">
    <div class="fleet-card-icon">
      <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="8" width="20" height="9" rx="2"/><path d="M6 17a2 2 0 1 0 4 0M14 17a2 2 0 1 0 4 0M2 12h20"/></svg>
    </div>
    <h3><%= t('frota.van.title') %></h3>
    <p><%= t('frota.van.desc') %></p>
  </article>
</section>

<section class="cta-band">
  <div class="cta-inner">
    <h2><%= t('cta.frota.title') %></h2>
    <a href="/contacto" class="btn btn-primary" data-nav><%= t('cta.frota.btn') %></a>
  </div>
</section>

<%- include('partials/footer') %>
</body>
</html>
