<!DOCTYPE html>
<html lang="pt">
<head>
<%- include('partials/head') %>
</head>
<body>
<%- include('partials/nav') %>

<section class="page-hero">
  <p class="hero-eyebrow"><%= t('page.servicos.eyebrow') %></p>
  <h1><%= t('page.servicos.title') %></h1>
  <p class="page-lede"><%= t('page.servicos.lede') %></p>
</section>

<section class="services-detail">
  <article class="service-card">
    <div class="service-card-icon">
      <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
    </div>
    <div class="service-card-text">
      <h2><%= t('servicos.aeroporto.title') %></h2>
      <p><%= t('servicos.aeroporto.desc') %></p>
      <ul class="service-list">
        <li><%= t('servicos.aeroporto.li1') %></li>
        <li><%= t('servicos.aeroporto.li2') %></li>
        <li><%= t('servicos.aeroporto.li3') %></li>
      </ul>
    </div>
  </article>

  <article class="service-card">
    <div class="service-card-icon">
      <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
    </div>
    <div class="service-card-text">
      <h2><%= t('servicos.executivo.title') %></h2>
      <p><%= t('servicos.executivo.desc') %></p>
      <ul class="service-list">
        <li><%= t('servicos.executivo.li1') %></li>
        <li><%= t('servicos.executivo.li2') %></li>
        <li><%= t('servicos.executivo.li3') %></li>
      </ul>
    </div>
  </article>

  <article class="service-card">
    <div class="service-card-icon">
      <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3 7h7l-5.5 4.5L18.5 21 12 16.5 5.5 21l2-7.5L2 9h7z"/></svg>
    </div>
    <div class="service-card-text">
      <h2><%= t('servicos.eventos.title') %></h2>
      <p><%= t('servicos.eventos.desc') %></p>
      <ul class="service-list">
        <li><%= t('servicos.eventos.li1') %></li>
        <li><%= t('servicos.eventos.li2') %></li>
        <li><%= t('servicos.eventos.li3') %></li>
      </ul>
    </div>
  </article>
</section>

<section class="cta-band">
  <div class="cta-inner">
    <h2><%= t('cta.servicos.title') %></h2>
    <a href="/contacto" class="btn btn-primary" data-nav><%= t('cta.servicos.btn') %></a>
  </div>
</section>

<%- include('partials/footer') %>
</body>
</html>
