<!DOCTYPE html>
<html lang="pt">
<head>
<%- include('partials/head') %>
</head>
<body>
<%- include('partials/nav') %>

<section class="page-hero">
  <p class="hero-eyebrow"><%= t('page.servicos.eyebrow') %></p>
  <h1><%= t('page.servicos.title') %></h1>
  <p class="page-lede"><%= t('page.servicos.lede') %></p>
</section>

<section class="services-detail">
  <article class="service-row">
    <div class="service-text">
      <h2><%= t('servicos.aeroporto.title') %></h2>
      <p><%= t('servicos.aeroporto.desc') %></p>
      <ul class="service-list">
        <li><%= t('servicos.aeroporto.li1') %></li>
        <li><%= t('servicos.aeroporto.li2') %></li>
        <li><%= t('servicos.aeroporto.li3') %></li>
      </ul>
    </div>
    <div class="service-visual" aria-hidden="true">
      <svg viewBox="0 0 300 200"><rect width="300" height="200" rx="18" fill="#0c1420"/><path d="M40 130 L130 60 L170 60 L260 130" stroke="#c9a16a" stroke-width="2" fill="none" opacity="0.6"/><circle cx="150" cy="95" r="4" fill="#ffe9b0"/></svg>
    </div>
  </article>

  <article class="service-row reverse">
    <div class="service-text">
      <h2><%= t('servicos.executivo.title') %></h2>
      <p><%= t('servicos.executivo.desc') %></p>
      <ul class="service-list">
        <li><%= t('servicos.executivo.li1') %></li>
        <li><%= t('servicos.executivo.li2') %></li>
        <li><%= t('servicos.executivo.li3') %></li>
      </ul>
    </div>
    <div class="service-visual" aria-hidden="true">
      <svg viewBox="0 0 300 200"><rect width="300" height="200" rx="18" fill="#0c1420"/><rect x="60" y="70" width="180" height="60" rx="10" fill="none" stroke="#b9c4d6" stroke-width="2" opacity="0.5"/><circle cx="90" cy="140" r="14" fill="none" stroke="#c9a16a" stroke-width="2"/><circle cx="210" cy="140" r="14" fill="none" stroke="#c9a16a" stroke-width="2"/></svg>
    </div>
  </article>

  <article class="service-row">
    <div class="service-text">
      <h2><%= t('servicos.eventos.title') %></h2>
      <p><%= t('servicos.eventos.desc') %></p>
      <ul class="service-list">
        <li><%= t('servicos.eventos.li1') %></li>
        <li><%= t('servicos.eventos.li2') %></li>
        <li><%= t('servicos.eventos.li3') %></li>
      </ul>
    </div>
    <div class="service-visual" aria-hidden="true">
      <svg viewBox="0 0 300 200"><rect width="300" height="200" rx="18" fill="#0c1420"/><path d="M90 140 L150 60 L210 140 Z" fill="none" stroke="#ffe9b0" stroke-width="2" opacity="0.7"/></svg>
    </div>
  </article>
</section>

<section class="cta-band">
  <div class="cta-inner">
    <h2><%= t('cta.servicos.title') %></h2>
    <a href="/contacto" class="btn btn-primary" data-nav><%= t('cta.servicos.btn') %></a>
  </div>
</section>

<%- include('partials/footer') %>
</body>
</html>
