<!DOCTYPE html>
<html lang="pt">
<head>
<%- include('partials/head') %>
</head>
<body>
<%- include('partials/nav') %>

<section class="page-hero">
  <p class="hero-eyebrow"><%= t('page.servicos.eyebrow') %></p>
  <h1><%= t('page.servicos.title') %></h1>
  <p class="page-lede"><%= t('page.servicos.lede') %></p>
</section>

<section class="services-detail">
  <article class="service-card">
    <div class="service-card-header">
      <div class="service-card-icon">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-1 .1-1.3.5l-.7.7c-.5.5-.4 1.3.2 1.6L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 2.8 5.8c.3.6 1.1.7 1.6.2l.7-.7c.4-.3.6-.8.5-1.3z"/></svg>
      </div>
      <h2><%= t('servicos.aeroporto.title') %></h2>
    </div>
    <div class="service-card-text">
      <p><%= t('servicos.aeroporto.desc') %></p>
      <ul class="service-list">
        <li><%= t('servicos.aeroporto.li1') %></li>
        <li><%= t('servicos.aeroporto.li2') %></li>
        <li><%= t('servicos.aeroporto.li3') %></li>
      </ul>
    </div>
  </article>

  <article class="service-card">
    <div class="service-card-header">
      <div class="service-card-icon">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
      </div>
      <h2><%= t('servicos.executivo.title') %></h2>
    </div>
    <div class="service-card-text">
      <p><%= t('servicos.executivo.desc') %></p>
      <ul class="service-list">
        <li><%= t('servicos.executivo.li1') %></li>
        <li><%= t('servicos.executivo.li2') %></li>
        <li><%= t('servicos.executivo.li3') %></li>
      </ul>
    </div>
  </article>

  <article class="service-card">
    <div class="service-card-header">
      <div class="service-card-icon">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3 7h7l-5.5 4.5L18.5 21 12 16.5 5.5 21l2-7.5L2 9h7z"/></svg>
      </div>
      <h2><%= t('servicos.eventos.title') %></h2>
    </div>
    <div class="service-card-text">
      <p><%= t('servicos.eventos.desc') %></p>
      <ul class="service-list">
        <li><%= t('servicos.eventos.li1') %></li>
        <li><%= t('servicos.eventos.li2') %></li>
        <li><%= t('servicos.eventos.li3') %></li>
      </ul>
    </div>
  </article>
</section>

<section class="cta-band">
  <div class="cta-inner">
    <h2><%= t('cta.servicos.title') %></h2>
    <a href="/contacto" class="btn btn-primary" data-nav><%= t('cta.servicos.btn') %></a>
  </div>
</section>

<%- include('partials/footer') %>
</body>
</html>
