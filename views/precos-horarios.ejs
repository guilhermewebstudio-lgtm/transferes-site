<!DOCTYPE html>
<html lang="pt">
<head>
<%- include('partials/head') %>
</head>
<body>
<%- include('partials/nav') %>

<section class="page-hero">
  <p class="hero-eyebrow">Informação prática</p>
  <h1>Preços & Horários</h1>
  <p class="page-lede">Tudo o que precisas de saber antes de reservar.</p>
</section>

<section class="pricing-grid">
  <div class="pricing-card">
    <span class="pricing-card-label">Económico</span>
    <div class="pricing-card-value"><%= precoEconomico %>€<span>/km</span></div>
    <p class="pricing-card-desc">Sedan compacto, ideal para trajetos ponto a ponto.</p>
  </div>
  <div class="pricing-card pricing-card-highlight">
    <span class="pricing-card-label">Conforto</span>
    <div class="pricing-card-value"><%= precoConforto %>€<span>/km</span></div>
    <p class="pricing-card-desc">A escolha mais popular para transfers executivos.</p>
  </div>
  <div class="pricing-card">
    <span class="pricing-card-label">Luxo</span>
    <div class="pricing-card-value"><%= precoLuxo %>€<span>/km</span></div>
    <p class="pricing-card-desc">Viaturas premium para uma experiência superior.</p>
  </div>
  <div class="pricing-card">
    <span class="pricing-card-label">Van de Grupo</span>
    <div class="pricing-card-value"><%= precoVan %>€<span>/km</span></div>
    <p class="pricing-card-desc">Até 8 passageiros com bagagem, ideal para grupos.</p>
  </div>
</section>

<section class="hours-section">
  <h2 class="hours-section-title">Horários</h2>
  <div class="hours-grid">
    <div class="hour-day">
      <span class="hour-day-name">Segunda</span>
      <span class="hour-day-value"><%= horarios.seg %></span>
    </div>
    <div class="hour-day">
      <span class="hour-day-name">Terça</span>
      <span class="hour-day-value"><%= horarios.ter %></span>
    </div>
    <div class="hour-day">
      <span class="hour-day-name">Quarta</span>
      <span class="hour-day-value"><%= horarios.qua %></span>
    </div>
    <div class="hour-day">
      <span class="hour-day-name">Quinta</span>
      <span class="hour-day-value"><%= horarios.qui %></span>
    </div>
    <div class="hour-day">
      <span class="hour-day-name">Sexta</span>
      <span class="hour-day-value"><%= horarios.sex %></span>
    </div>
    <div class="hour-day">
      <span class="hour-day-name">Sábado</span>
      <span class="hour-day-value"><%= horarios.sab %></span>
    </div>
    <div class="hour-day">
      <span class="hour-day-name">Domingo</span>
      <span class="hour-day-value"><%= horarios.dom %></span>
    </div>
  </div>
</section>

<section class="cta-band">
  <div class="cta-inner">
    <h2>Pronto para reservar o teu transfer?</h2>
    <a href="/contacto" class="btn btn-primary" data-nav>Pedir orçamento</a>
  </div>
</section>

<%- include('partials/footer') %>
</body>
</html>
