<!DOCTYPE html>
<html lang="pt">
<head>
<%- include('partials/head') %>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
</head>
<body>
<%- include('partials/nav') %>

<section class="page-hero">
  <p class="hero-eyebrow"><%= t('sim.eyebrow') %></p>
  <h1><%= t('sim.title') %></h1>
  <p class="page-lede"><%= t('sim.lede') %></p>
</section>

<section class="sim-section">
  <div class="sim-form-card">
    <label><%= t('sim.origem') %>
      <input type="text" id="sim-origem" placeholder="Ex: Aeroporto de Lisboa" autocomplete="off">
    </label>
    <label><%= t('sim.destino') %>
      <input type="text" id="sim-destino" placeholder="Ex: Cascais" autocomplete="off">
    </label>
    <label><%= t('sim.categoria') %>
      <select id="sim-categoria">
        <option value="0.90"><%= t('form.frota_economico') %> — 0,90€/km</option>
        <option value="1.20" selected><%= t('form.frota_conforto') %> — 1,20€/km</option>
        <option value="1.60"><%= t('form.frota_luxo') %> — 1,60€/km</option>
        <option value="1.30"><%= t('form.frota_van') %> — 1,30€/km</option>
      </select>
    </label>
    <button id="sim-calcular" class="btn btn-primary" type="button"><%= t('sim.calcular') %></button>
    <p id="sim-erro" class="form-feedback error" style="display:none;"></p>

    <div id="sim-resultado" class="sim-result" style="display:none;">
      <div class="sim-result-row">
        <span><%= t('sim.distancia') %></span>
        <strong id="sim-distancia">—</strong>
      </div>
      <div class="sim-result-row">
        <span><%= t('sim.duracao') %></span>
        <strong id="sim-duracao">—</strong>
      </div>
      <div class="sim-result-row sim-result-price">
        <span><%= t('sim.preco') %></span>
        <strong id="sim-preco">—</strong>
      </div>
      <p class="sim-disclaimer"><%= t('sim.disclaimer') %></p>
      <a href="/contacto" class="btn btn-primary" data-nav style="margin-top:14px;"><%= t('sim.reservar_viagem') %></a>
    </div>
  </div>

  <div class="sim-map-col">
    <div id="sim-map" class="sim-map"></div>
    <div id="sim-instrucoes" class="sim-instrucoes" style="display:none;">
      <h3><%= t('sim.instrucoes') %></h3>
      <ol id="sim-instrucoes-lista"></ol>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script src="/js/simulador.js"></script>
</body>
</html>
