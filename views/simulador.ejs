<!DOCTYPE html>
<html lang="pt">
<head>
<%- include('partials/head') %>
</head>
<body>
<%- include('partials/nav') %>

<section class="page-hero">
  <p class="hero-eyebrow">Simulador</p>
  <h1>Calcula o preço da tua viagem</h1>
  <p class="page-lede">Indica a origem, o destino e a categoria de viatura — mostramos logo a distância e o preço estimado.</p>
</section>

<section class="sim-section sim-section-single">
  <div class="sim-form-card">
    <label>Origem
      <input type="text" id="sim-origem" placeholder="Ex: Aeroporto de Lisboa" autocomplete="off">
    </label>
    <label>Destino
      <input type="text" id="sim-destino" placeholder="Ex: Cascais" autocomplete="off">
    </label>
    <label>Categoria
      <select id="sim-categoria">
        <option value="0.90">Económico — 0,90€/km</option>
        <option value="1.20" selected>Conforto — 1,20€/km</option>
        <option value="1.60">Luxo — 1,60€/km</option>
        <option value="1.30">Van de Grupo — 1,30€/km</option>
      </select>
    </label>
    <button id="sim-calcular" class="btn btn-primary" type="button">Calcular preço</button>
    <p id="sim-erro" class="form-feedback error" style="display:none;"></p>

    <div id="sim-resultado" class="sim-result" style="display:none;">
      <div class="sim-result-row">
        <span>Distância</span>
        <strong id="sim-distancia">—</strong>
      </div>
      <div class="sim-result-row">
        <span>Duração estimada</span>
        <strong id="sim-duracao">—</strong>
      </div>
      <div class="sim-result-row sim-result-price">
        <span>Preço estimado</span>
        <strong id="sim-preco">—</strong>
      </div>
      <p class="sim-disclaimer">Este valor é uma estimativa baseada na distância. O preço final é confirmado após a reserva.</p>
      <a href="/contacto" class="btn btn-primary" data-nav style="margin-top:14px;">Reservar esta viagem</a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
<script src="/js/simulador.js"></script>
</body>
</html>
